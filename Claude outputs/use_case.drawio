<mxfile host="app.diagrams.net">
  <diagram id="usecase" name="Use case">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Граница системы -->
        <mxCell id="sys" value="Игра «[НАЗВАНИЕ]»" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="260" y="30" width="560" height="790" as="geometry" />
        </mxCell>

        <!-- Акторы -->
        <mxCell id="guest" value="Гость" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="player" value="Игрок" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="530" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ai" value="Компьютерный&lt;br&gt;противник" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="930" y="640" width="30" height="60" as="geometry" />
        </mxCell>

        <!-- Варианты использования (левый столбец) -->
        <mxCell id="uc1" value="Зарегистрироваться" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="70" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc2" value="Авторизоваться" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc3" value="Начать партию" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc4" value="Переместить короля" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="450" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc5" value="Выстрелить из дробовика" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="540" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc6" value="Просмотреть сведения о фигуре" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="630" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc7" value="Просмотреть таблицу лидеров" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="250" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc8" value="Начать игру заново" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="720" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Варианты использования (правый столбец) -->
        <mxCell id="uc9" value="Перезарядить дробовик" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="450" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc10" value="Прицелиться" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="540" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc11" value="Сделать ход белыми фигурами" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="630" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc12" value="Превратить пешку" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="730" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Обобщение: Игрок наследует возможности Гостя -->
        <mxCell id="gen1" style="endArrow=block;endFill=0;endSize=14;html=1;" edge="1" parent="1" source="player" target="guest">
          <mxGeometry relative="1" as="geometry" />
