        <!-- Ассоциации Игрок -->
        <mxCell id="a3" style="endArrow=none;html=1;" edge="1" parent="1" source="player" target="uc3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" style="endArrow=none;html=1;" edge="1" parent="1" source="player" target="uc4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" style="endArrow=none;html=1;" edge="1" parent="1" source="player" target="uc5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" style="endArrow=none;html=1;" edge="1" parent="1" source="player" target="uc6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7" style="endArrow=none;html=1;" edge="1" parent="1" source="guest" target="uc7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a8" style="endArrow=none;html=1;" edge="1" parent="1" source="player" target="uc8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Ассоциации Компьютерный противник -->
        <mxCell id="a9" style="endArrow=none;html=1;" edge="1" parent="1" source="ai" target="uc11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- include / extend -->
        <mxCell id="inc1" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;" edge="1" parent="1" source="uc4" target="uc9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc2" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;" edge="1" parent="1" source="uc5" target="uc10">
